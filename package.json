{
  "name": "peru-ubigeo",
  "version": "0.1.2",
  "description": "Librería ligera y actualizada para consultar códigos de Ubigeo del Perú (Departamentos, Provincias y Distritos). Soporte TypeScript.",
  "homepage": "https://github.com/Komarcalabs/ubigeoperu#readme",
  "author": {
    "name": "Lord Dicus (KomarcaLabs)",
    "email": "jholarck@gmail.com",
    "url": "https://github.com/Komarcalabs"
  },
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "keywords": [
    "peru",
    "ubigeo",
    "peru-ubigeo",
    "inei",
    "reniec",
    "sunat",
    "departamentos",
    "provincias",
    "distritos",
    "komarcalabs",
    "typescript"
  ],
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-config-xo": "^0.43.1",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6"
  },
  "engines": {
    "npm": ">= 4.0.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "git add"
    ],
    "*.json": [
      "prettier --write",
      "git add"
    ]
  },
  "eslintConfig": {
    "extends": [
      "xo",
      "prettier"
    ],
    "env": {
      "jest": true,
      "node": true
    },
    "rules": {
      "prettier/prettier": "error"
    },
    "plugins": [
      "prettier"
    ]
  },
  "scripts": {
    "pretest": "eslint .",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Komarcalabs/ubigeoperu.git"
  },
  "bugs": {
    "url": "https://github.com/Komarcalabs/ubigeoperu/issues"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "license": "MIT"
}
